<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:DexHub.Core.Models;assembly=DexHub.Core"
             xmlns:p="clr-namespace:DexHub.Core.Pokedex;assembly=DexHub.Core"
             x:Class="DexHub.UI.MainView"
             Background="{StaticResource DexBackground}"
             Foreground="{StaticResource DexText}"
             FontFamily="{StaticResource DexFont}">

  <Panel>
  <Grid x:Name="Shell" RowDefinitions="Auto,*,Auto">

    <!-- Kompakte Kopfleiste (nur auf schmalen Bildschirmen, z. B. Handy) -->
    <Border x:Name="CompactHeader" IsVisible="False" Padding="12,8">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#EE1C3A" />
          <GradientStop Offset="1" Color="#A3081F" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Grid Width="34" Height="34" VerticalAlignment="Center">
          <Ellipse Fill="#F4F6FA" />
          <Ellipse Width="26" Height="26" Fill="#3BA7FF" Stroke="#1E2A3A" StrokeThickness="1.5" />
          <Ellipse Width="7" Height="7" Fill="White" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,9,0,0" />
        </Grid>
        <TextBlock Grid.Column="1" Text="DexHub" FontSize="20" FontWeight="Bold" Foreground="White"
                   VerticalAlignment="Center" Margin="10,0,0,0" />
        <ComboBox Grid.Column="3" x:Name="CompactProfileBox" MinWidth="130" SelectionChanged="OnCompactProfileChanged" />
      </Grid>
    </Border>

    <!-- Seitenleiste: Hintergrund -->
    <Border x:Name="SidebarBackground" Grid.Row="1" Width="236" HorizontalAlignment="Left" Background="{StaticResource DexSidebar}"
            BorderBrush="{StaticResource DexBorder}" BorderThickness="0,0,1,0" />

    <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="1" SelectionChanged="OnMainTabChanged">

      <TabItem Classes="group" IsEnabled="False" Header="SPIELEN" />
      <!-- ============ Bibliothek ============ -->
      <TabItem Header="Bibliothek" Tag="🎮">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Bibliothek" />
            <TextBlock x:Name="LibrarySubtitle" Classes="muted" Text="Deine Spiele, nach Konsolen sortiert. Doppelklick startet, Rechtsklick zeigt mehr." TextWrapping="Wrap" />
          </StackPanel>
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid x:Name="LibrarySearchRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBox x:Name="LibrarySearchBox" HorizontalAlignment="Left" Width="320" Watermark="Spiel suchen…"
                     TextChanged="OnLibrarySearchChanged" />
            <StackPanel x:Name="LibraryButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button x:Name="RomFolderButton" Content="ROM-Ordner…" Click="OnBrowseRomFolderClick" />
              <Button Content="Neu scannen" Click="OnRescanClick" />
            </StackPanel>
          </Grid>

          <!-- Kacheln, nach Konsolen gruppiert (wird im Code aufgebaut) -->
          <ScrollViewer Grid.Row="1" Margin="0,8">
            <StackPanel x:Name="LibraryPanel" Spacing="6" />
          </ScrollViewer>

          <Border Grid.Row="2" Classes="card" Padding="12,10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="▶  Spielen" Click="OnPlayClick" Classes="primary" />
            <Button x:Name="PlayFreshButton" Content="Ohne Fortsetzen starten" Click="OnPlayFreshClick"
                    ToolTip.Tip="Startet das Spiel neu, statt die automatische Sicherung zu laden" />
            <TextBlock x:Name="SelectedGameText" VerticalAlignment="Center" Classes="muted"
                       Text="Doppelklick startet ein Spiel, Rechtsklick zeigt mehr." />
          </StackPanel>
          </Border>
        </Grid>
        </DockPanel>
      </TabItem>
      <!-- ============ Spielstände (wird im Code aufgebaut) ============ -->
      <TabItem x:Name="SavesTab" Header="Spielstände" Tag="💾">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Spielstände" />
            <TextBlock Classes="muted" Text="Alle Spielstände pro Benutzer – importieren, exportieren, sichern." TextWrapping="Wrap" />
          </StackPanel>
        <ScrollViewer>
          <StackPanel x:Name="SavesPanel" Spacing="8" Margin="0,12,12,12" />
        </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Classes="group" IsEnabled="False" Header="SAMMLUNG" />
      <!-- ============ Pokédex ============ -->
      <TabItem Header="Pokédex" Tag="📕">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Pokédex" />
            <TextBlock Classes="muted" Text="Alle Pokémon – was du gefangen ● und gesehen ○ hast, über alle deine Spiele." TextWrapping="Wrap" />
          </StackPanel>
        <Grid x:Name="DexGrid" ColumnDefinitions="*,300" RowDefinitions="Auto,*" Margin="0,8,0,0">
          <WrapPanel Grid.ColumnSpan="2" ItemSpacing="8" LineSpacing="8">
            <TextBox x:Name="SearchBox" Width="240" Watermark="Name oder Nummer…"
                     TextChanged="OnSearchChanged" />
            <ComboBox x:Name="GenFilter" SelectedIndex="0" Width="110"
                      SelectionChanged="OnGenFilterChanged">
              <ComboBoxItem>Alle Gen.</ComboBoxItem>
              <ComboBoxItem>Gen 1</ComboBoxItem>
              <ComboBoxItem>Gen 2</ComboBoxItem>
              <ComboBoxItem>Gen 3</ComboBoxItem>
              <ComboBoxItem>Gen 4</ComboBoxItem>
              <ComboBoxItem>Gen 5</ComboBoxItem>
              <ComboBoxItem>Gen 6</ComboBoxItem>
              <ComboBoxItem>Gen 7</ComboBoxItem>
              <ComboBoxItem>Gen 8</ComboBoxItem>
              <ComboBoxItem>Gen 9</ComboBoxItem>
            </ComboBox>
            <ComboBox x:Name="DexShowBox" SelectedIndex="0" Width="250"
                      SelectionChanged="OnDexShowChanged">
              <ComboBoxItem>Alle anzeigen</ComboBoxItem>
              <ComboBoxItem>Nur gefangene</ComboBoxItem>
              <ComboBoxItem>Nur fehlende</ComboBoxItem>
              <ComboBoxItem>Fehlend, in meinen Spielen erhältlich</ComboBoxItem>
            </ComboBox>
            <TextBlock x:Name="DexCounter" VerticalAlignment="Center" Opacity="0.7" />
            <Button Content="Daten neu laden" Click="OnReloadDexClick" />
          </WrapPanel>

          <!-- Kacheln nach Generationen (wird im Code aufgebaut) -->
          <ScrollViewer Grid.Row="1" Margin="0,8,8,0">
            <StackPanel x:Name="DexPanel" Spacing="6" />
          </ScrollViewer>

          <!-- Detailansicht -->
          <ScrollViewer x:Name="DexDetail" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
          <StackPanel Spacing="10" Margin="0,0,12,0">
            <!-- Pokédex-Bildschirm -->
            <Border CornerRadius="14" Padding="10" Background="#D9DDE4">
              <Border Height="200" CornerRadius="8" BorderBrush="#0B2A4A" BorderThickness="2">
                <Border.Background>
                  <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,35%" RadiusX="70%" RadiusY="70%">
                    <GradientStop Offset="0" Color="#2E7FC8" />
                    <GradientStop Offset="1" Color="#0D2F55" />
                  </RadialGradientBrush>
                </Border.Background>
                <Image x:Name="SpriteImage" Width="192" Height="192"
                       RenderOptions.BitmapInterpolationMode="None" />
              </Border>
            </Border>
            <TextBlock x:Name="DetailName" FontSize="22" FontWeight="Bold"
                       Text="Pokémon auswählen" />
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" />
            <Button x:Name="OpenInGuideButton" Content="📖 Im Guide öffnen" Click="OnOpenInGuideClick" IsVisible="False" />
            <StackPanel x:Name="WhereToFindPanel" Spacing="4" />
            <TextBlock Opacity="0.5" FontSize="12" TextWrapping="Wrap"
                       Text="● gefangen   ○ gesehen. Zählt, was im Spiel gespeichert wurde (Gen 1 bis 5)." />
          </StackPanel>
          </ScrollViewer>
        </Grid>
        </DockPanel>
      </TabItem>
      <!-- ============ Statistik (wird im Code aufgebaut) ============ -->
      <TabItem Header="Statistik" Tag="📊">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Statistik" />
            <TextBlock Classes="muted" Text="Deine Pokémon, Fortschritt, Erfolge, Shiny-Jagden und der Rückblick." TextWrapping="Wrap" />
          </StackPanel>
        <Grid x:Name="StatsGrid" ColumnDefinitions="*,330" Margin="0,8,0,0">
          <ScrollViewer Margin="0,0,8,0">
            <StackPanel x:Name="StatsPanel" Spacing="8" />
          </ScrollViewer>
          <Border x:Name="StatsDetail" Grid.Column="1" Classes="card" Padding="14">
            <ScrollViewer>
              <StackPanel x:Name="PokemonDetailPanel" Spacing="8">
                <TextBlock Text="Pokémon anklicken, um Details zu sehen." Opacity="0.6" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        </DockPanel>
      </TabItem>
      <!-- ============ Tauschen (wird im Code aufgebaut) ============ -->
      <TabItem Header="Tauschen" Tag="🔄">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Tauschcenter" />
            <TextBlock Classes="muted" Text="Pokémon zwischen zwei Spielständen tauschen – auch zwischen Benutzern." TextWrapping="Wrap" />
          </StackPanel>
        <ScrollViewer>
          <StackPanel x:Name="TradePanel" Spacing="10" Margin="0,12,12,12" />
        </ScrollViewer>
        </DockPanel>
      </TabItem>
      <!-- ============ Pokémon-Bank (wird im Code aufgebaut) ============ -->
      <TabItem Header="Bank" Tag="🏦">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Pokémon-Bank" />
            <TextBlock Classes="muted" Text="Pokémon ablegen und in ein anderes Spiel holen – auch über Generationen hinweg." TextWrapping="Wrap" />
          </StackPanel>
        <ScrollViewer>
          <StackPanel x:Name="BankPanel" Spacing="10" Margin="0,12,12,12" />
        </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Classes="group" IsEnabled="False" Header="WISSEN" />
      <!-- ============ Guide ============ -->
      <TabItem x:Name="GuideTab" Header="Guide" Tag="📖">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Guide" />
            <TextBlock Classes="muted" Text="Typen, Attacken, Fundorte und Entwicklungen – passend zur gewählten Edition." TextWrapping="Wrap" />
          </StackPanel>
        <DockPanel Margin="0,8,0,0">
          <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,8">
            <Button x:Name="GuideBackButton" Content="← Zurück" Click="OnGuideBackClick" IsEnabled="False" />
            <Button x:Name="GuideModePokemon" Content="Pokémon" Click="OnGuideModeClick" Tag="pokemon" />
            <Button x:Name="GuideModeTypes" Content="Typen" Click="OnGuideModeClick" Tag="types" />
            <Button x:Name="GuideModeMoves" Content="Attacken" Click="OnGuideModeClick" Tag="moves" />
            <Button x:Name="GuideModeTeam" Content="Team-Planer" Click="OnGuideModeClick" Tag="team" />
            <TextBlock Text="Edition:" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8" />
            <ComboBox x:Name="GuideVersionBox" Width="280" SelectionChanged="OnGuideVersionChanged" />
            <TextBlock x:Name="GuideStatus" VerticalAlignment="Center" Opacity="0.7" />
          </WrapPanel>
          <Grid x:Name="GuideGrid" ColumnDefinitions="260,*">
            <DockPanel x:Name="GuideSide">
              <TextBox x:Name="GuideSearchBox" DockPanel.Dock="Top" Watermark="Suchen (Name oder Nummer)…"
                       TextChanged="OnGuideSearchChanged" Margin="0,0,0,6" />
              <ListBox x:Name="GuideList" SelectionChanged="OnGuideListSelectionChanged" />
            </DockPanel>
            <ScrollViewer x:Name="GuideScroll" Grid.Column="1" Margin="12,0,0,0">
              <StackPanel x:Name="GuideContent" Spacing="10" Margin="0,0,12,12" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
        </DockPanel>
      </TabItem>
      <TabItem Classes="group" IsEnabled="False" Header="EINSTELLUNGEN" />
      <!-- ============ Steuerung (wird im Code aufgebaut) ============ -->
      <TabItem Header="Steuerung" Tag="🕹️">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Steuerung" />
            <TextBlock Classes="muted" Text="Tastatur und Controller belegen, Hotkeys festlegen." TextWrapping="Wrap" />
          </StackPanel>
        <ScrollViewer>
          <StackPanel x:Name="ControlsPanel" Spacing="10" Margin="0,12,12,12" MaxWidth="820" HorizontalAlignment="Left" />
        </ScrollViewer>
        </DockPanel>
      </TabItem>
      <!-- ============ Bild (wird im Code aufgebaut) ============ -->
      <TabItem Header="Bild" Tag="🖼️">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Bild" />
            <TextBlock Classes="muted" Text="Skalierung, Effekte und Bildschirm-Anordnung pro Konsole." TextWrapping="Wrap" />
          </StackPanel>
        <ScrollViewer>
          <StackPanel x:Name="VideoPanel" Spacing="8" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left" />
        </ScrollViewer>
        </DockPanel>
      </TabItem>
      <!-- ============ Einstellungen ============ -->
      <TabItem Header="Einstellungen" Tag="⚙️">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Einstellungen" />
            <TextBlock Classes="muted" Text="Ordner, Ton, Updates und Sicherungen." TextWrapping="Wrap" />
          </StackPanel>
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">

            <Expander Header="Bibliothek" IsExpanded="True" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock Text="ROM-Ordner" FontWeight="SemiBold" />
                <Grid x:Name="RomFolderRow" ColumnDefinitions="*,Auto,Auto">
                  <TextBox x:Name="RomFolderBox" />
                  <Button Grid.Column="1" Content="…" Margin="6,0,0,0" Click="OnBrowseRomFolderClick" />
                  <Button Grid.Column="2" Content="Speichern" Classes="primary" Margin="6,0,0,0" Click="OnSaveSettingsClick" />
                </Grid>
                <CheckBox x:Name="ShowAllGamesBox" IsCheckedChanged="OnShowAllGamesChanged"
                          Content="Auch Spiele ohne Pokémon anzeigen (z. B. Zelda, Mario – spielbar, aber ohne Pokédex &amp; Co.)" />
              </StackPanel>
            </Expander>

            <Expander Header="Ton &amp; Spielen" IsExpanded="True" HorizontalAlignment="Stretch">
              <Grid x:Name="SoundGrid" ColumnDefinitions="180,*" RowDefinitions="44,44,44,44">
                <TextBlock Text="Lautstärke" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="260"
                          ValueChanged="OnVolumeChanged" />
                  <TextBlock x:Name="VolumeText" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Schnellvorlauf" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FastForwardBox" Width="160"
                          SelectionChanged="OnFastForwardChanged">
                  <ComboBoxItem>2-fach</ComboBoxItem>
                  <ComboBoxItem>3-fach</ComboBoxItem>
                  <ComboBoxItem>4-fach</ComboBoxItem>
                  <ComboBoxItem>8-fach</ComboBoxItem>
                  <ComboBoxItem>Unbegrenzt</ComboBoxItem>
                </ComboBox>

                <TextBlock Grid.Row="2" Text="Vorspul-Modus" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FastForwardModeBox" Width="320"
                          SelectionChanged="OnFastForwardModeChanged">
                  <ComboBoxItem>Halten (läuft, solange gedrückt)</ComboBoxItem>
                  <ComboBoxItem>Umschalten (Druck an, Druck aus)</ComboBoxItem>
                </ComboBox>

                <TextBlock Grid.Row="3" Text="Fortsetzen" VerticalAlignment="Center" />
                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="AutoResumeBox"
                          Content="Beim Schließen automatisch sichern und beim nächsten Start dort weitermachen"
                          IsCheckedChanged="OnAutoResumeChanged" />
              </Grid>
            </Expander>

            <Expander x:Name="UpdatesExpander" Header="Updates" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock x:Name="VersionText" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Nach Updates suchen" Click="OnCheckUpdatesClick" />
                  <Button x:Name="InstallUpdateButton" Content="Update installieren" Classes="primary"
                          IsVisible="False" Click="OnUpdateClick" />
                </StackPanel>
                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Opacity="0.8" />
              </StackPanel>
            </Expander>

            <Expander Header="Automatische Sicherung" HorizontalAlignment="Stretch">
              <StackPanel x:Name="BackupSettingsPanel" Spacing="8" />
            </Expander>

            <Expander Header="Emulatoren &amp; Ordner" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock x:Name="CoreStatusText" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
                <TextBlock x:Name="FoldersText" TextWrapping="Wrap" Opacity="0.8" />
              </StackPanel>
            </Expander>

          </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </TabItem>

    </TabControl>

    <!-- Pokédex-Kopfteil oben links: rotes Gehäuse mit Linse und Lämpchen -->
    <Border x:Name="SidebarHeader" Grid.Row="1" Width="236" Height="160" HorizontalAlignment="Left" VerticalAlignment="Top"
            CornerRadius="0,0,18,0" ClipToBounds="True">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#EE1C3A" />
          <GradientStop Offset="1" Color="#A3081F" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid RowDefinitions="*,Auto,10">
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="18,16,0,0" VerticalAlignment="Top">
          <!-- große Linse -->
          <Grid Width="62" Height="62">
            <Ellipse Fill="#F4F6FA" />
            <Ellipse Width="50" Height="50" Stroke="#1E2A3A" StrokeThickness="2">
              <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="35%,30%" Center="50%,50%" RadiusX="60%" RadiusY="60%">
                  <GradientStop Offset="0" Color="#B5E2FF" />
                  <GradientStop Offset="0.45" Color="#3BA7FF" />
                  <GradientStop Offset="1" Color="#0B4FA8" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="13" Height="13" Fill="White" Opacity="0.75"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,15,0,0" />
          </Grid>
          <!-- drei Lämpchen -->
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Top" Margin="0,4,0,0">
            <Ellipse Width="13" Height="13" Fill="#FF5A5A" Stroke="#5A0010" StrokeThickness="1.5" />
            <Ellipse Width="13" Height="13" Fill="#FFD93D" Stroke="#5A4A00" StrokeThickness="1.5" />
            <Ellipse Width="13" Height="13" Fill="#4CD964" Stroke="#0A4A1A" StrokeThickness="1.5" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="20,0,0,10">
          <TextBlock Text="DexHub" FontSize="26" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Pokémon-Emulator &amp; Pokédex" FontSize="12" Foreground="#FFD0D6" />
        </StackPanel>
        <!-- Scharnier -->
        <Border Grid.Row="2" Background="#7A0618" />
      </Grid>
    </Border>

    <!-- Trainerkarte unten links -->
    <Border x:Name="TrainerCard" Grid.Row="1" Width="236" Height="132" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="12,0,12,10">
      <Border Classes="card" Padding="10">
        <StackPanel Spacing="7">
          <TextBlock Classes="eyebrow" Text="TRAINER" />
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource DexRed}" Margin="0,0,8,0">
              <TextBlock x:Name="ProfileInitial" Text="?" Foreground="White" FontWeight="Bold" FontSize="15"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ComboBox Grid.Column="1" x:Name="ProfileBox" HorizontalAlignment="Stretch" SelectionChanged="OnProfileChanged"
                      ToolTip.Tip="Jeder Benutzer hat eigene Spielstände." />
          </Grid>
          <Grid ColumnDefinitions="*,6,*">
            <Button Content="+ Neu" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="6,6"
                    Click="OnAddProfileClick" ToolTip.Tip="Neuen Benutzer anlegen" />
            <Button Grid.Column="2" Content="Großbild" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="6,6"
                    Click="OnBigPictureClick"
                    ToolTip.Tip="Vollbild, mit dem Controller bedienbar (auch: DexHub --bigpicture)" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Statuszeile -->
    <Border Grid.Row="2" Padding="16,6" Background="#111318" BorderBrush="{StaticResource DexBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Text="Bereit." FontSize="12" Foreground="{StaticResource DexMuted}" VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="UpdateButton" Classes="primary" Content="⬆ Update installieren" IsVisible="False"
                Padding="12,3" FontSize="12" Click="OnUpdateClick" />
      </Grid>
    </Border>
  </Grid>

  <!-- Dialoge (Meldung, Frage, Eingabe) erscheinen hier über allem – funktioniert auch auf Android -->
  <Border x:Name="DialogLayer" IsVisible="False" Background="#B0000000">
    <Border x:Name="DialogCard" Classes="card" MaxWidth="520" Margin="20" Padding="22"
            HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 10 40 0 #80000000" />
  </Border>
  </Panel>
</UserControl>
