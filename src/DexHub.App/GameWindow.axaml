<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DexHub.App"
        x:Class="DexHub.App.GameWindow"
        Title="DexHub"
        Width="800" Height="640"
        Background="Black">

  <!-- Das Grid hat einen Hintergrund, damit Mausklicks überall ankommen (Touchscreen beim DS) -->
  <Grid x:Name="Surface" Background="Black"
        PointerPressed="OnPointerPressed"
        PointerMoved="OnPointerMoved"
        PointerReleased="OnPointerReleased">

    <!-- Spielbild; beim DS zwei Bildschirme, die im Code angeordnet werden -->
    <Canvas x:Name="ScreenCanvas" ClipToBounds="True">
      <Image x:Name="ScreenA" Stretch="Fill" />
      <Image x:Name="ScreenB" Stretch="Fill" IsVisible="False" />
    </Canvas>

    <!-- Scanlines / LCD-Raster -->
    <local:EffectOverlay x:Name="Effects" IsHitTestVisible="False" />

    <!-- Touch-Zeiger für den Controller (DS) -->
    <Canvas IsHitTestVisible="False">
      <Ellipse x:Name="TouchCursor" Width="20" Height="20" IsVisible="False"
               Stroke="White" StrokeThickness="2" Fill="#66E3350D" />
    </Canvas>

    <!-- Shiny-Jagd-Zähler -->
    <Border x:Name="HuntBorder" IsVisible="False" IsHitTestVisible="False"
            VerticalAlignment="Top" HorizontalAlignment="Right"
            Margin="12" Padding="12,5" CornerRadius="10" Background="#D01A1D23"
            BorderBrush="#F5C542" BorderThickness="1">
      <TextBlock x:Name="HuntText" Foreground="#FFD54F" FontWeight="SemiBold" FontSize="16" />
    </Border>

    <Border x:Name="OsdBorder" IsVisible="False"
            VerticalAlignment="Bottom" HorizontalAlignment="Left"
            Margin="12" Padding="12,7" CornerRadius="10" Background="#E01A1D23"
            BorderBrush="#DC0A2D" BorderThickness="3,0,0,0">
      <TextBlock x:Name="OsdText" Foreground="White" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
