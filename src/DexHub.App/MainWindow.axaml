<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:DexHub.Core.Models;assembly=DexHub.Core"
        xmlns:p="clr-namespace:DexHub.Core.Pokedex;assembly=DexHub.Core"
        x:Class="DexHub.App.MainWindow"
        Title="DexHub"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="500">

  <DockPanel>
    <!-- Statuszeile unten -->
    <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <TextBlock x:Name="StatusText" Text="Bereit." />
    </Border>

    <!-- Benutzer -->
    <Border DockPanel.Dock="Top" Padding="16,10,16,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Benutzer:" VerticalAlignment="Center" Opacity="0.8" />
        <ComboBox x:Name="ProfileBox" MinWidth="180" SelectionChanged="OnProfileChanged" />
        <Button Content="+ Neuer Benutzer" Click="OnAddProfileClick" />
        <Button x:Name="UpdateButton" Content="⬆ Update verfügbar" Classes="accent" IsVisible="False" Click="OnUpdateClick" />
        <Button Content="🎮 Großbild-Modus" Click="OnBigPictureClick"
                ToolTip.Tip="Vollbild, mit dem Controller bedienbar (auch: DexHub --bigpicture)" />
        <TextBlock VerticalAlignment="Center" Opacity="0.5"
                   Text="Jeder Benutzer hat eigene Spielstände." />
      </StackPanel>
    </Border>

    <TabControl x:Name="MainTabs" Margin="8" SelectionChanged="OnMainTabChanged">

      <!-- ============ Bibliothek ============ -->
      <TabItem Header="Bibliothek">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="ROM-Ordner wählen…" Click="OnBrowseRomFolderClick" />
            <Button Content="Neu scannen" Click="OnRescanClick" />
            <TextBox x:Name="LibrarySearchBox" Width="220" Watermark="Spiel suchen…"
                     TextChanged="OnLibrarySearchChanged" />
          </StackPanel>

          <!-- Kacheln, nach Konsolen gruppiert (wird im Code aufgebaut) -->
          <ScrollViewer Grid.Row="1" Margin="0,8">
            <StackPanel x:Name="LibraryPanel" Spacing="6" />
          </ScrollViewer>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="▶ Spielen" Click="OnPlayClick" Classes="accent" />
            <Button Content="Ohne Fortsetzen starten" Click="OnPlayFreshClick"
                    ToolTip.Tip="Startet das Spiel neu, statt die automatische Sicherung zu laden" />
            <TextBlock x:Name="SelectedGameText" VerticalAlignment="Center" Opacity="0.7"
                       Text="Doppelklick startet ein Spiel, Rechtsklick zeigt mehr." />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============ Pokédex ============ -->
      <TabItem Header="Pokédex">
        <Grid ColumnDefinitions="*,300" RowDefinitions="Auto,*" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" Grid.ColumnSpan="2">
            <TextBox x:Name="SearchBox" Width="220" Watermark="Name oder Nummer…"
                     TextChanged="OnSearchChanged" />
            <ComboBox x:Name="GenFilter" SelectedIndex="0" Width="110"
                      SelectionChanged="OnGenFilterChanged">
              <ComboBoxItem>Alle Gen.</ComboBoxItem>
              <ComboBoxItem>Gen 1</ComboBoxItem>
              <ComboBoxItem>Gen 2</ComboBoxItem>
              <ComboBoxItem>Gen 3</ComboBoxItem>
              <ComboBoxItem>Gen 4</ComboBoxItem>
              <ComboBoxItem>Gen 5</ComboBoxItem>
              <ComboBoxItem>Gen 6</ComboBoxItem>
              <ComboBoxItem>Gen 7</ComboBoxItem>
              <ComboBoxItem>Gen 8</ComboBoxItem>
              <ComboBoxItem>Gen 9</ComboBoxItem>
            </ComboBox>
            <ComboBox x:Name="DexShowBox" SelectedIndex="0" Width="250"
                      SelectionChanged="OnDexShowChanged">
              <ComboBoxItem>Alle anzeigen</ComboBoxItem>
              <ComboBoxItem>Nur gefangene</ComboBoxItem>
              <ComboBoxItem>Nur fehlende</ComboBoxItem>
              <ComboBoxItem>Fehlend, in meinen Spielen erhältlich</ComboBoxItem>
            </ComboBox>
            <TextBlock x:Name="DexCounter" VerticalAlignment="Center" Opacity="0.7" />
            <Button Content="Daten neu laden" Click="OnReloadDexClick" />
          </StackPanel>

          <!-- Kacheln nach Generationen (wird im Code aufgebaut) -->
          <ScrollViewer Grid.Row="1" Margin="0,8,8,0">
            <StackPanel x:Name="DexPanel" Spacing="6" />
          </ScrollViewer>

          <!-- Detailansicht -->
          <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
          <StackPanel Spacing="10" Margin="0,0,12,0">
            <Border Height="200" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
              <Image x:Name="SpriteImage" Width="192" Height="192"
                     RenderOptions.BitmapInterpolationMode="None" />
            </Border>
            <TextBlock x:Name="DetailName" FontSize="20" FontWeight="SemiBold"
                       Text="Pokémon auswählen" />
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" />
            <Button x:Name="OpenInGuideButton" Content="📖 Im Guide öffnen" Click="OnOpenInGuideClick" IsVisible="False" />
            <StackPanel x:Name="WhereToFindPanel" Spacing="4" />
            <TextBlock Opacity="0.5" FontSize="12" TextWrapping="Wrap"
                       Text="● gefangen   ○ gesehen. Zählt, was im Spiel gespeichert wurde (Gen 1 bis 4)." />
          </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ============ Guide ============ -->
      <TabItem x:Name="GuideTab" Header="Guide">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="GuideBackButton" Content="← Zurück" Click="OnGuideBackClick" IsEnabled="False" />
            <Button x:Name="GuideModePokemon" Content="Pokémon" Click="OnGuideModeClick" Tag="pokemon" />
            <Button x:Name="GuideModeTypes" Content="Typen" Click="OnGuideModeClick" Tag="types" />
            <Button x:Name="GuideModeMoves" Content="Attacken" Click="OnGuideModeClick" Tag="moves" />
            <TextBlock Text="Edition:" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8" />
            <ComboBox x:Name="GuideVersionBox" Width="280" SelectionChanged="OnGuideVersionChanged" />
            <TextBlock x:Name="GuideStatus" VerticalAlignment="Center" Opacity="0.7" />
          </StackPanel>
          <Grid ColumnDefinitions="260,*">
            <DockPanel>
              <TextBox x:Name="GuideSearchBox" DockPanel.Dock="Top" Watermark="Suchen (Name oder Nummer)…"
                       TextChanged="OnGuideSearchChanged" Margin="0,0,0,6" />
              <ListBox x:Name="GuideList" SelectionChanged="OnGuideListSelectionChanged" />
            </DockPanel>
            <ScrollViewer x:Name="GuideScroll" Grid.Column="1" Margin="12,0,0,0">
              <StackPanel x:Name="GuideContent" Spacing="10" Margin="0,0,12,12" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ============ Statistik (wird im Code aufgebaut) ============ -->
      <TabItem Header="Statistik">
        <Grid ColumnDefinitions="*,330" Margin="0,8,0,0">
          <ScrollViewer Margin="0,0,8,0">
            <StackPanel x:Name="StatsPanel" Spacing="8" />
          </ScrollViewer>
          <Border Grid.Column="1" CornerRadius="8" Padding="12"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <ScrollViewer>
              <StackPanel x:Name="PokemonDetailPanel" Spacing="8">
                <TextBlock Text="Pokémon anklicken, um Details zu sehen." Opacity="0.6" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- ============ Spielstände (wird im Code aufgebaut) ============ -->
      <TabItem x:Name="SavesTab" Header="Spielstände">
        <ScrollViewer>
          <StackPanel x:Name="SavesPanel" Spacing="8" Margin="0,12,12,12" />
        </ScrollViewer>
      </TabItem>

      <!-- ============ Tauschen (wird im Code aufgebaut) ============ -->
      <TabItem Header="Tauschen">
        <ScrollViewer>
          <StackPanel x:Name="TradePanel" Spacing="10" Margin="0,12,12,12" />
        </ScrollViewer>
      </TabItem>

      <!-- ============ Pokémon-Bank (wird im Code aufgebaut) ============ -->
      <TabItem Header="Bank">
        <ScrollViewer>
          <StackPanel x:Name="BankPanel" Spacing="10" Margin="0,12,12,12" />
        </ScrollViewer>
      </TabItem>

      <!-- ============ Steuerung (wird im Code aufgebaut) ============ -->
      <TabItem Header="Steuerung">
        <ScrollViewer>
          <StackPanel x:Name="ControlsPanel" Spacing="10" Margin="0,12,12,12" MaxWidth="820" HorizontalAlignment="Left" />
        </ScrollViewer>
      </TabItem>

      <!-- ============ Bild (wird im Code aufgebaut) ============ -->
      <TabItem Header="Bild">
        <ScrollViewer>
          <StackPanel x:Name="VideoPanel" Spacing="8" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left" />
        </ScrollViewer>
      </TabItem>

      <!-- ============ Einstellungen ============ -->
      <TabItem Header="Einstellungen">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="0,12,12,12" MaxWidth="900" HorizontalAlignment="Left">

            <Expander Header="Bibliothek" IsExpanded="True" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock Text="ROM-Ordner" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBox x:Name="RomFolderBox" />
                  <Button Grid.Column="1" Content="…" Margin="6,0,0,0" Click="OnBrowseRomFolderClick" />
                  <Button Grid.Column="2" Content="Speichern" Classes="accent" Margin="6,0,0,0" Click="OnSaveSettingsClick" />
                </Grid>
              </StackPanel>
            </Expander>

            <Expander Header="Ton &amp; Spielen" IsExpanded="True" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="180,*" RowDefinitions="44,44,44,44">
                <TextBlock Text="Lautstärke" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="260"
                          ValueChanged="OnVolumeChanged" />
                  <TextBlock x:Name="VolumeText" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Schnellvorlauf" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FastForwardBox" Width="160"
                          SelectionChanged="OnFastForwardChanged">
                  <ComboBoxItem>2-fach</ComboBoxItem>
                  <ComboBoxItem>3-fach</ComboBoxItem>
                  <ComboBoxItem>4-fach</ComboBoxItem>
                  <ComboBoxItem>8-fach</ComboBoxItem>
                  <ComboBoxItem>Unbegrenzt</ComboBoxItem>
                </ComboBox>

                <TextBlock Grid.Row="2" Text="Vorspul-Modus" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FastForwardModeBox" Width="320"
                          SelectionChanged="OnFastForwardModeChanged">
                  <ComboBoxItem>Halten (läuft, solange gedrückt)</ComboBoxItem>
                  <ComboBoxItem>Umschalten (Druck an, Druck aus)</ComboBoxItem>
                </ComboBox>

                <TextBlock Grid.Row="3" Text="Fortsetzen" VerticalAlignment="Center" />
                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="AutoResumeBox"
                          Content="Beim Schließen automatisch sichern und beim nächsten Start dort weitermachen"
                          IsCheckedChanged="OnAutoResumeChanged" />
              </Grid>
            </Expander>

            <Expander Header="Updates" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock x:Name="VersionText" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Nach Updates suchen" Click="OnCheckUpdatesClick" />
                  <Button x:Name="InstallUpdateButton" Content="Update installieren" Classes="accent"
                          IsVisible="False" Click="OnUpdateClick" />
                </StackPanel>
                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Opacity="0.8" />
              </StackPanel>
            </Expander>

            <Expander Header="Emulatoren &amp; Ordner" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock x:Name="CoreStatusText" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
                <TextBlock x:Name="FoldersText" TextWrapping="Wrap" Opacity="0.8" />
              </StackPanel>
            </Expander>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
